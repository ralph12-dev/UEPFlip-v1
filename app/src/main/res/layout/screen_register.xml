<?xml version="1.0" encoding="utf-8"?>
<!-- Register screen. Design only: no logic, no navigation, not referenced by any Activity/Fragment. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_page"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:layout_width="230dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="56dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/auth_mascot_desc"
            android:src="@drawable/auth_mascot_peek"
            android:translationY="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/auth_bg_sheet"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingTop="26dp"
            android:paddingBottom="28dp">

            <TextView
                style="@style/Auth.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/register_title"
                android:textSize="20sp" />

            <TextView
                style="@style/Auth.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/register_subtitle"
                android:textSize="11sp" />

            <!-- First / Last name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Auth.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/register_first_name" />

                    <EditText
                        style="@style/Auth.Field"
                        android:hint="@string/register_first_name"
                        android:inputType="textPersonName|textCapWords" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Auth.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/register_last_name" />

                    <EditText
                        style="@style/Auth.Field"
                        android:hint="@string/register_last_name"
                        android:inputType="textPersonName|textCapWords" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Auth.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/auth_email" />

            <EditText
                style="@style/Auth.Field"
                android:hint="@string/auth_email_hint"
                android:inputType="textEmailAddress" />

            <TextView
                style="@style/Auth.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/register_birth_date" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    style="@style/Auth.Field"
                    android:hint="@string/register_birth_date_hint"
                    android:inputType="date"
                    android:paddingEnd="44dp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="@string/auth_icon_desc_calendar"
                    android:src="@drawable/auth_ic_calendar" />
            </FrameLayout>

            <TextView
                style="@style/Auth.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/auth_password" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    style="@style/Auth.Field"
                    android:hint="@string/auth_password_hint"
                    android:inputType="textPassword"
                    android:paddingEnd="44dp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="@string/auth_icon_desc_toggle_password"
                    android:src="@drawable/auth_ic_eye_off" />
            </FrameLayout>

            <TextView
                style="@style/Auth.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/register_confirm_password" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    style="@style/Auth.Field"
                    android:hint="@string/register_confirm_password_hint"
                    android:inputType="textPassword"
                    android:paddingEnd="44dp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="@string/auth_icon_desc_toggle_password"
                    android:src="@drawable/auth_ic_eye_off" />
            </FrameLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                style="@style/Auth.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/register_button" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
