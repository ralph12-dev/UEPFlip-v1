<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/UF.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
    android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/monogram" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_stats_tile"
                android:gravity="center" android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold" tools:text="PA"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="14dp" android:orientation="vertical">
                <TextView android:id="@+id/deck_name" style="@style/UF.H2" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="Cloud computing"/>
                <TextView android:id="@+id/deck_count" style="@style/UF.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" tools:text="7 cards"/>
                <TextView android:id="@+id/deck_review" style="@style/UF.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" tools:text="Next review: Oct 20" tools:visibility="visible"/>
            </LinearLayout>
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chev" android:contentDescription="@null"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
            <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/deck_progress" style="@style/UF.Progress" android:layout_width="match_parent" android:layout_height="wrap_content" tools:progress="40"/>
            </FrameLayout>
            <TextView android:id="@+id/deck_pct" style="@style/UF.Muted" android:layout_width="44dp" android:layout_height="wrap_content" android:gravity="end" tools:text="0%"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
