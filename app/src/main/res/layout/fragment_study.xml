<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg"
    android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="12dp" android:paddingBottom="16dp">

    <!-- Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageButton android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp"
            android:background="@drawable/bg_back_button" android:src="@drawable/ic_back" android:padding="12dp"
            android:contentDescription="@string/back"/>
        <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/study_progress"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="14dp"
            app:trackThickness="8dp" app:trackCornerRadius="4dp" app:indicatorColor="@color/ink" app:trackColor="@color/track"/>
        <TextView android:id="@+id/study_counter" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minWidth="52dp" android:gravity="end" android:textSize="15sp" android:textColor="@color/mute"/>
    </LinearLayout>

    <!-- Flashcard -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="18dp" android:minHeight="220dp" android:padding="6dp" android:clipToPadding="false" android:clipChildren="false">

        <LinearLayout android:id="@+id/card_front" android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:padding="28dp" android:background="@drawable/bg_study_card_front"
            android:elevation="6dp" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/study_label_question"
                android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.14" android:textColor="@color/mute"/>
            <TextView android:id="@+id/question" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:gravity="center_vertical" android:fontFamily="serif" android:textSize="28sp"
                android:lineSpacingMultiplier="1.1" android:textColor="@color/ink"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/track"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="16dp"
                android:gravity="center" android:text="@string/study_tap_reveal" android:textSize="13sp" android:textColor="@color/mute"
                android:drawableStart="@drawable/ic_flip" android:drawablePadding="8dp" android:drawableTint="@color/mute"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/card_back" android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:padding="28dp" android:background="@drawable/bg_study_card_back"
            android:elevation="6dp" android:clickable="true" android:focusable="true" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/study_label_answer"
                android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.14" android:textColor="@color/on_dark_mute"/>
            <TextView android:id="@+id/answer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:gravity="center_vertical" android:fontFamily="serif" android:textSize="24sp"
                android:lineSpacingMultiplier="1.12" android:textColor="@color/bg"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider_on_dark"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="16dp"
                android:gravity="center" android:text="@string/study_tap_question" android:textSize="13sp" android:textColor="@color/on_dark_mute"
                android:drawableStart="@drawable/ic_flip" android:drawablePadding="8dp" android:drawableTint="@color/on_dark_mute"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Hint panel: filled in on demand by the AI -->
    <LinearLayout android:id="@+id/hint_panel" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:padding="14dp" android:background="@drawable/bg_hint_panel" android:visibility="gone">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginTop="1dp"
            android:src="@drawable/ic_bulb" android:contentDescription="@null"/>
        <TextView android:id="@+id/hint_text" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:textSize="14sp" android:textColor="@color/ink"/>
    </LinearLayout>

    <!-- Actions -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_hint"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="0.9" android:layout_marginEnd="6dp"
            android:insetTop="0dp" android:insetBottom="0dp" android:paddingStart="8dp" android:paddingEnd="8dp"
            android:text="@string/study_request_hint" android:textSize="14sp" android:textStyle="bold" android:textAllCaps="false" android:maxLines="1"
            android:textColor="@color/ink" app:backgroundTint="@color/card" app:strokeColor="@color/line" app:strokeWidth="1.5dp"
            app:cornerRadius="16dp" app:icon="@drawable/ic_bulb" app:iconSize="20dp" app:iconPadding="8dp" app:iconGravity="textStart" app:iconTint="@color/ink"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_ai"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1.1" android:layout_marginStart="6dp"
            android:insetTop="0dp" android:insetBottom="0dp" android:paddingStart="8dp" android:paddingEnd="8dp"
            android:text="@string/study_ask_ai" android:textSize="14sp" android:textStyle="bold" android:textAllCaps="false" android:maxLines="1"
            android:textColor="@color/ink" app:backgroundTint="@color/card" app:strokeColor="@color/line" app:strokeWidth="1.5dp"
            app:cornerRadius="16dp" app:icon="@drawable/ic_chat" app:iconSize="20dp" app:iconPadding="8dp" app:iconGravity="textStart" app:iconTint="@color/ink"/>
    </LinearLayout>

    <!-- Difficulty: the design keeps the rating visible; "Next card" commits it -->
    <TextView android:id="@+id/rate_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:text="@string/study_rate_label" android:textSize="14sp" android:textStyle="bold"
        android:textColor="@color/ink"/>
    <LinearLayout android:id="@+id/difficulty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:padding="4dp" android:background="@drawable/bg_segment_container" android:orientation="horizontal">
        <TextView android:id="@+id/diff_easy" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:gravity="center" android:text="@string/easy" android:textSize="15sp" android:clickable="true" android:focusable="true"
            android:foreground="?attr/selectableItemBackground"/>
        <TextView android:id="@+id/diff_normal" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:layout_marginHorizontal="4dp" android:gravity="center" android:text="@string/normal" android:textSize="15sp" android:clickable="true" android:focusable="true"
            android:foreground="?attr/selectableItemBackground"/>
        <TextView android:id="@+id/diff_hard" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:gravity="center" android:text="@string/hard" android:textSize="15sp" android:clickable="true" android:focusable="true"
            android:foreground="?attr/selectableItemBackground"/>
    </LinearLayout>

    <!-- Next card: waits for the reveal so a card is never rated blind -->
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_next_card"
        android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp"
        android:insetTop="0dp" android:insetBottom="0dp" android:text="@string/next_card" android:textSize="17sp" android:textStyle="bold"
        android:textAllCaps="false" android:textColor="@color/bg" app:backgroundTint="@color/ink" app:cornerRadius="18dp"
        app:icon="@drawable/ic_arrow_right" app:iconTint="@color/bg" app:iconSize="20dp" app:iconPadding="10dp" app:iconGravity="textEnd"/>
</LinearLayout>
