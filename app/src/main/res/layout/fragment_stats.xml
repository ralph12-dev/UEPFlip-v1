<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView style="@style/UF.Logo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_brand"/>
        <TextView style="@style/UF.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/stats_title"/>

        <com.google.android.material.card.MaterialCardView style="@style/UF.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <TextView style="@style/UF.H2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stats_progress_title"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/stat_decks" style="@style/UF.Title" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView style="@style/UF.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stats_label_decks"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/stat_cards" style="@style/UF.Title" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView style="@style/UF.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stats_label_cards"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/stat_due" style="@style/UF.Title" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView style="@style/UF.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stats_label_due"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/stat_mastered" style="@style/UF.Title" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView style="@style/UF.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stats_label_mastered"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/UF.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <TextView style="@style/UF.H2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stats_history_title"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/stat_reviews" style="@style/UF.Title" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView style="@style/UF.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stats_label_total_reviews"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/stat_reviews_week" style="@style/UF.Title" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView style="@style/UF.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stats_label_last_7_days"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/stat_recall" style="@style/UF.Title" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView style="@style/UF.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stats_label_recall"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView android:id="@+id/stat_empty" style="@style/UF.Muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:visibility="gone" android:text="@string/stats_empty"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/UF.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <TextView style="@style/UF.H2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stats_sr_title"/>
                <TextView style="@style/UF.Muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/stats_sr_body"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
