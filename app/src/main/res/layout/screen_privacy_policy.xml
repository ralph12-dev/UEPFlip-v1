<?xml version="1.0" encoding="utf-8"?>
<!-- Privacy & Policy screen (opened from Privacy & Policy on My Profile). Design only, not connected to anything. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/me_bg"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="40dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/me_cd_back"
                android:padding="8dp"
                android:src="@drawable/me_ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/pp_title"
                android:textColor="@color/me_ink"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="124dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/me_bg_hero"
            android:clipToOutline="true">

            <View
                android:layout_width="220dp"
                android:layout_height="90dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="-30dp"
                android:background="@drawable/me_bg_hill"
                android:translationY="44dp" />

            <ImageView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="6dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/me_cd_mascot"
                android:src="@drawable/auth_mascot_peek" />

            <LinearLayout
                android:layout_width="190dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pp_hero_title"
                    android:textColor="@color/me_ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/pp_hero_body"
                    android:textColor="@color/me_mute"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/me_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/me_divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="86dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp">

                    <ImageView android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/me_bg_chip" android:contentDescription="@null" android:padding="8dp" android:src="@drawable/me_ic_shield_check" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pp_policy" android:textColor="@color/me_ink" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/pp_policy_desc" android:textColor="@color/me_mute" android:textSize="12sp" android:lineSpacingExtra="2dp" />
                    </LinearLayout>
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="8dp" android:contentDescription="@null" android:src="@drawable/me_ic_chevron" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="18dp" android:background="@color/me_divider" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="86dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp">

                    <ImageView android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/me_bg_chip" android:contentDescription="@null" android:padding="8dp" android:src="@drawable/me_ic_doc" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pp_terms" android:textColor="@color/me_ink" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/pp_terms_desc" android:textColor="@color/me_mute" android:textSize="12sp" android:lineSpacingExtra="2dp" />
                    </LinearLayout>
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="8dp" android:contentDescription="@null" android:src="@drawable/me_ic_chevron" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="18dp" android:background="@color/me_divider" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="86dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp">

                    <ImageView android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/me_bg_chip" android:contentDescription="@null" android:padding="8dp" android:src="@drawable/me_ic_shield" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pp_security" android:textColor="@color/me_ink" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/pp_security_desc" android:textColor="@color/me_mute" android:textSize="12sp" android:lineSpacingExtra="2dp" />
                    </LinearLayout>
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="8dp" android:contentDescription="@null" android:src="@drawable/me_ic_chevron" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="18dp" android:background="@color/me_divider" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="86dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp">

                    <ImageView android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/me_bg_chip" android:contentDescription="@null" android:padding="8dp" android:src="@drawable/me_ic_info" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pp_contact" android:textColor="@color/me_ink" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/pp_contact_desc" android:textColor="@color/me_mute" android:textSize="12sp" android:lineSpacingExtra="2dp" />
                    </LinearLayout>
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="8dp" android:contentDescription="@null" android:src="@drawable/me_ic_chevron" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
