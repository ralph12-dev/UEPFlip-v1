<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView style="@style/UF.Logo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/app_brand"/>

        <ImageView android:id="@+id/btn_profile" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="10dp"
            android:background="@drawable/me_bg_avatar_button" android:contentDescription="@string/me_cd_profile" android:elevation="3dp"
            android:padding="5dp" android:scaleType="fitCenter" android:src="@drawable/ic_mascot"/>
    </LinearLayout>
    <TextView style="@style/UF.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/decks_title"/>
    <EditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="14dp" android:background="@drawable/bg_input"
        android:drawableStart="@drawable/ic_search" android:drawablePadding="10dp" android:paddingHorizontal="13dp" android:hint="@string/decks_search_hint"
        android:imeOptions="actionSearch" android:importantForAutofill="no" android:inputType="text" android:maxLines="1"
        android:textColor="@color/ink" android:textColorHint="@color/mute" android:textSize="14sp"/>
    <com.google.android.material.chip.ChipGroup android:id="@+id/filters" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="10dp" app:singleSelection="true" app:selectionRequired="true">
        <com.google.android.material.chip.Chip android:id="@+id/chip_all" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/decks_filter_all" android:checked="true"/>
        <com.google.android.material.chip.Chip android:id="@+id/chip_progress" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/decks_filter_progress"/>
        <com.google.android.material.chip.Chip android:id="@+id/chip_done" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/decks_filter_done"/>
    </com.google.android.material.chip.ChipGroup>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/deck_list" android:layout_width="match_parent" android:layout_height="match_parent"/>
        <TextView android:id="@+id/decks_empty" style="@style/UF.Muted" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center" android:gravity="center" android:padding="24dp" android:visibility="gone"/>
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_deck"
        style="@style/UF.Button.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/decks_new"
        app:icon="@drawable/ic_plus"
        app:iconGravity="textStart"
        app:iconPadding="6dp" />
</LinearLayout>
