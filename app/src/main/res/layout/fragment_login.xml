<?xml version="1.0" encoding="utf-8"?>
<!-- Login fragment: Google Sign-In + Guest bypass. Wired into the fragment shell. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header with back button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@null"
                android:padding="12dp"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/back" />

            <TextView
                style="@style/UF.H2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/login_title" />
        </LinearLayout>

        <!-- Illustration -->
        <ImageView
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:contentDescription="@string/auth_mascot_desc"
            android:src="@drawable/auth_mascot_peek" />

        <!-- Title + Subtitle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                style="@style/Auth.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_title" />

            <TextView
                style="@style/Auth.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/login_subtitle" />
        </LinearLayout>

        <!-- Google Sign-In button -->
        <Button
            android:id="@+id/btn_login_google"
            style="@style/Auth.Button.Light"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/login_google" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="@color/line" />

        <!-- Guest button -->
        <Button
            android:id="@+id/btn_login_guest"
            style="@style/Auth.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_guest" />

        <!-- Guest note -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="@string/login_guest_note"
            android:textColor="@color/auth_hint"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>